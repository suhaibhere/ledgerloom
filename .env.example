NODE_ENV=development
HOST=127.0.0.1
PORT=4173
SESSION_SECRET=replace-with-a-long-random-secret-before-production
DATABASE_PATH=./data/ledgerloom.sqlite
# Optional for local SQLite -> use PostgreSQL in hosting (Supabase session pooler URL)
DATABASE_URL=
# DATABASE_SSL=disable
# Optional Gemini chatbot (keep the API key on the server; never put it in frontend code).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
